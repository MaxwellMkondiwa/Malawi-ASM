      TIES;
1897   
1898  * CALCULATE INPUT/OUTPUT COEFFICIENTS FOR LIVESTOCK PRODUCTION ACTIVITIES 
      USING BUDGET COEFFICIENTS AND
1899  * CORRESPONDING BUDGET MULTIPLIERS, ADJUSTING FOR UNIT CONVERSIONS
1900   
1901  *          AR(JR,JXL,JIP)$JRX(JR,JXL) = SUM(JBL$(JBR(JR,JBL) AND (CNV1(JBL
      ,JXL)>0)),
1902  *                                             CNV2(JIP)*ALM(JR,JBL,JXR)*AL
      (JR,JBL,JIP)/CNV1(JBL,JXR));
1903   
1904  *         AR(JR,JXP,JIP)$JRX(JR,JXP) = ARP(JR,JXP,JIP);
1905   
1906  PARAMETER  ARC(JR,JXC,JIT,JIP)  PRODUCT AND INPUT COEF FOR REG CROP PROD A
      CTIVITIES;
1907   
1908  PARAMETER  AOR(JR,JXR,JOC)  OTHER CONSTRAINT COEF FOR REGIONAL PROD ACTIVI
      TIES;
1909   
1910  PARAMETER  AORC(JR,JXC,JIT,JOC)  OTHER CONSTRAINT COEF FOR REG CROP PROD A
      CTIVITIES;
1911   
1912  PARAMETER  BOR(JR,JOC)  RHS FOR OTHER REGIONAL CONSTRAINTS;
1913   
