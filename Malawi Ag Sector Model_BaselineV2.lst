 389  SET JROCR(JR,JOCR)  OTHER REGIONAL CONSTRAINTS MAPPED TO REGIONS;
 390  SET JOCN(JOC)  OTHER NONREGIONAL PRODUCTION ACTIVITY CONSTRAINTS;
