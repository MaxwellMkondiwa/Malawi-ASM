SUPPLY AND DEMAND PARAMETER DECLARATIONS AND ASSIGNMENTS


 595  * REGIONAL AND NONREGIONAL INPUTS, AND CROP LAND INPUTS, HAVE SUPPLY ACTIV
      ITIES.  SINCE THE OBJECTIVE
 596  * FUNCTION OF THE MODEL IS CONSUMER PLUS PRODUCER SURPLUS, THE OBJECTIVE F
      UNCTION ENTRY FOR AN INPUT
 597  * SUPPLY ACTIVITY IS MINUS THE SUPPLY FUNCTION INTEGRAL.  SUPPLY FUNCTIONS
       ARE ASSUMED TO BE LINEAR IN
 598  * THIS VERSION OF MAGS, HOWEVER RELAXATION OF THAT ASSUMPTION IS STRAIGHT 
      FORWARD AND CAN BE ACCOMODATED
 599  * WITH GAMS.  PARAMETERS ARE ASSIGNED OR COMPUTED IN PRICE DEPENDENT FORM.
        AN INFINITELY ELASTIC SUPPLY
 600  * IS INDICATED BY A ZERO SLOPE WITH THE INTERCEPT THEN BECOMING THE CONSTA
      NT MARKET PRICE.  IF IN THE
 601  * FOLLOWING TABLES BOTH THE INTERCEPT AND SLOPE ARE ZERO, OR EQUIVALENTLY 
      BLANK, THE SLOPE AND INTERCEPT
 602  * WILL BE COMPUTED WITH THE USER ASSIGNED PRICE, QUANTITY AND ELASTICITY (
      PBAR, QBAR AND ELAST,
 603  * RESPECTIVELY) IF ALL THREE OF THESE PARAMETERS ARE STRICTLY POSITIVE.
 604  *
 605  * FIXED SUPPLIES CAN BE MODELED BY SETTING APPROPRIATE VALUES FOR QMIN AND
       QMAX WHICH ARE USED AS LOWER
 606  * AND UPPER BOUNDS, RESPECTIVELY, ON THE SUPPLY ACTIVITIES.  IF EXOGENOUS 
      SUPPLY FUNCTIONS ARE TO BE
 607  * USED WITHOUT OTHER LIMITS TO SUPPLY, QMIN SHOULD BE SET TO ZERO AND QMAX
       SHOULD BE SET TO INFINITY
 608  * (INF).  A POSITIVE QMIN AND OR A FINITE QMAX MAY BE SET, IF DESIRED, WIT
      H AN EXOGENOUS SUPPLY FUNCTION
 609  * THAT IS PRICE RESPONSIVE OR INFINITELY ELASTIC FROM QMIN TO QMAX.
 610  *
 611  * PRICES ARE IN DOLLARS OR OTHER BASE CURRENCY USED IN THE MODEL.  QUANTIT
      IES ARE IN THE UNITS DEFINED
 612  * BY THE USER FOR THE INPUT'S SUPPLY ACTIVITY AND CONSTRAINT.
 613  *
 614   
 615   
 616  TABLE  CSR(JR,JIR,JSDP)  REGIONAL INPUT SUPPLY PARAMETERS
 958   
 959  * CHECK TO SEE IF ELAST PBAR AND QBAR ARE TO BE USED TO CALCULATE THE INTE
      RCEPT & SLOPE FOR THE INVERSE
 960  * SUPPLY FUNCTION FOR EACH REGIONAL INPUT IN EACH REGION. IF INDICATED, CA
      LCULATE THE SLOPE & INTERCEPT.
 961   
 962    SET CHECKCSR(JR,JIR);
 963    CHECKCSR(JR,JIR)=NO;
 964    CHECKCSR(JR,JIR)$((CSR(JR,JIR,"SLOPE")=0) AND (CSR(JR,JIR,"INTERCEPT")=0
      )
 965             AND (CSR(JR,JIR,"PBAR")>0) AND (CSR(JR,JIR,"QBAR")>0) AND (CSR(
      JR,JIR,"ELAST")>0)) = YES;
 966    CSR(JR,JIR,"SLOPE")$CHECKCSR(JR,JIR) = CSR(JR,JIR,"PBAR")/(CSR(JR,JIR,"Q
      BAR")*CSR(JR,JIR,"ELAST"));
 967    CSR(JR,JIR,"INTERCEPT")$CHECKCSR(JR,JIR)
 968        = CSR(JR,JIR,"PBAR") - (CSR(JR,JIR,"PBAR")/CSR(JR,JIR,"ELAST"));
 969   
 970   
 971   
 972   
 973  PARAMETER  CSC(JR,JIT,JIC,JSDP)  CROP LAND INPUT SUPPLY PARAMETERS;
 974             CSC(JR,JIT,JIC,JSDP) = 0.0;
 975             CSC(JR,JIT,JIC,"QMIN") = -INF;
 976  *           CSC(JR,JIT,"CL-RICE","QMAX") = 20000;
 977             CSC(JR,JIT,"CONVEX","QMIN") = 1.0;
 978             CSC(JR,JIT,"CONVEX","QMAX") = 1.0;
 979   
 980   
 981   
      TABLE   CSC(JR,JIT,JIC,JSDP)  CROP LAND INPUT SUPPLY PARAMETERS
      $OFFLISTING;
      *$INCLUDE C:\0 Teaching\ApEc 8202\Exams\CSR.INC
       $INCLUDE C:\Users\mkond001\OneDrive\APEC8202_Readings\Term Project\Sector
       Modelling\Prototype Model_Prof Appland\Sector Programming Data\CSC.INC
      ;
      $ONLISTING;
       
       
       
      * CHECK TO SEE IF ELAST PBAR AND QBAR ARE TO BE USED TO CALCULATE THE INTE
      RCEPT & SLOPE FOR THE INVERSE
      * SUPPLY FUNCTION FOR EACH CROP LAND INPUT FOR EACH CROP LAND TYPE IN EACH
       REGION. IF INDICATED,
      * CALCULATE THE SLOPE & INTERCEPT.
       
 997    SET CHECKCSC(JR,JIT,JIC);
 998    CHECKCSC(JR,JIT,JIC)=NO;
 999    CHECKCSC(JR,JIT,JIC)$((CSC(JR,JIT,JIC,"SLOPE")=0) AND (CSC(JR,JIT,JIC,"I
      NTERCEPT")=0)
1000             AND (CSC(JR,JIT,JIC,"PBAR")>0) AND (CSC(JR,JIT,JIC,"QBAR")>0)
1001             AND (CSC(JR,JIT,JIC,"ELAST")>0)) = YES;
1002    CSC(JR,JIT,JIC,"SLOPE")$CHECKCSC(JR,JIT,JIC)
1003                           = CSC(JR,JIT,JIC,"PBAR")/(CSC(JR,JIT,JIC,"QBAR")*
      CSC(JR,JIT,JIC,"ELAST"));
1004    CSC(JR,JIT,JIC,"INTERCEPT")$CHECKCSC(JR,JIT,JIC)
1005        = CSC(JR,JIT,JIC,"PBAR") - (CSC(JR,JIT,JIC,"PBAR")/CSC(JR,JIT,JIC,"E
      LAST"));
1006   
      PARAMETER  CSN(JIN,JSDP)  NONREGIONAL INPUT SUPPLY PARAMETERS;
                 CSN(JIN,JSDP) = 0.0;
                 CSN(JIN,"QMAX") = INF;
       
       
      * CHECK TO SEE IF ELAST PBAR AND QBAR ARE TO BE USED TO CALCULATE THE INTE
      RCEPT & SLOPE FOR THE INVERSE
      * SUPPLY FUNCTION FOR EACH NON-REGIONAL INPUT. IF INDICATED, CALCULATE THE
       SLOPE & INTERCEPT.
       
        SET CHECKCSN(JIN);
        CHECKCSN(JIN)=NO;
        CHECKCSN(JIN)$((CSN(JIN,"SLOPE")=0) AND (CSN(JIN,"INTERCEPT")=0)
                AND (CSN(JIN,"PBAR")>0) AND (CSN(JIN,"QBAR")>0) AND (CSN(JIN,"EL
      AST")>0)) = YES;
       CSN(JIN,"SLOPE")$CHECKCSN(JIN) = CSN(JIN,"PBAR")/(CSN(JIN,"QBAR")*CSN(JIN
      ,"ELAST"));
        CSN(JIN,"INTERCEPT")$CHECKCSN(JIN) = CSN(JIN,"PBAR") - (CSN(JIN,"PBAR")/
      CSN(JIN,"ELAST"));
       
