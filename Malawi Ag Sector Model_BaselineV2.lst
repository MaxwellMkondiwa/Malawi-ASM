      PARAMETER  RT51(JXL,JR)  LIVESTOCK PROD ACTIVITY LEVELS;
       RT51(JXL,JR)$JRX(JR,JXL) = XR.L(JR,JXL);
       OPTION  RT51:3:1:1;     DISPLAY$PRNT("51")  RT51;
       
      PARAMETER  RT61(JXP,JR)  PROCESSING ACTIVITY LEVELS;
       RT61(JXP,JR)$JRX(JR,JXP) = XR.L(JR,JXP);
       OPTION  RT61:3:1:1;     DISPLAY$PRNT("61")  RT61;
       
      PARAMETER  RT62(JXP,JR,JU,JTH1)  PROCESSING ACTIVITY RESULTS;
       RT62(JXP,JR,JU,"LOWER")$(JUX(JXP,JU) AND JRX(JR,JXP)) = XR.LO(JR,JXP);
       RT62(JXP,JR,JU,"LEVEL")$(JUX(JXP,JU) AND JRX(JR,JXP)) = XR.L(JR,JXP);
       RT62(JXP,JR,JU,"UPPER")$(JUX(JXP,JU) AND JRX(JR,JXP)) = XR.UP(JR,JXP);
       RT62(JXP,JR,JU,"MARGINAL")$(JUX(JXP,JU) AND JRX(JR,JXP)) = XR.M(JR,JXP);
       OPTION  RT62:4:3:1;    DISPLAY$PRNT("62") RT62;
       
      PARAMETER  RT63(JXP,JR,JIP,JTH2)  PROCESSING RESULTS TABLE 63;
       RT63(JXP,JR,JIP,"QUANTITY")$JRX(JR,JXP) = ARP(JR,JXP,JIP)*XR.L(JR,JXP);
       RT63(JXP,JR,JIR,"PRICE")
           $(JRX(JR,JXP) AND (ARP(JR,JXP,JIR) NE 0) AND (RT63(JXP,JR,JIR,"QUANTI
      TY") NE 0)) = INPUTREG.M(JR,JIR);
       RT63(JXP,JR,JIN,"PRICE")
           $(JRX(JR,JXP) AND (ARP(JR,JXP,JIN) NE 0) AND (RT63(JXP,JR,JIN,"QUANTI
      TY") NE 0)) = INPUTNON.M(JIN);
       RT63(JXP,JR,JPR,"PRICE")
           $(JRX(JR,JXP) AND (ARP(JR,JXP,JPR) NE 0) AND (RT63(JXP,JR,JPR,"QUANTI
      TY") NE 0)) = PRODREG.M(JR,JPR);
       RT63(JXP,JR,JPN,"PRICE")
           $(JRX(JR,JXP) AND (ARP(JR,JXP,JPN) NE 0) AND (RT63(JXP,JR,JPN,"QUANTI
      TY") NE 0)) = PRODNON.M(JPN);
       RT63(JXP,JR,JIP,"VALUE")$(JRX(JR,JXP) AND (RT63(JXP,JR,JIP,"QUANTITY") NE
       0))
           = RT63(JXP,JR,JIP,"QUANTITY")*RT63(JXP,JR,JIP,"PRICE");
       OPTION  RT63:3:1:1;    DISPLAY$PRNT("63") RT63;
