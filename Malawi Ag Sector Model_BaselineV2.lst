  13   
  14  * MAXWELL: 27TH FEB 2019
  15  * Add Policy Scenarios.  Active only the line
  16  *associated to the scenario of interest and run de model
  17  SET SWITCH /BASELINE, ZEROTRANSPORTCOST,HALFTRANSPORTCOST,DOUBLETRANSPORTC
      OST/;
  18   
  19  *PARAMETERS SCENARIOS(SWITCH) BASELINESC /BASELINE 1,ZEROTRANSPORTCOST 0,H
      ALFTRANSPORTCOST 0,DOUBLETRANSPORTCOST 0/;
  20  *PARAMETERS SCENARIOS(SWITCH) ZEROTRANSPORTCOSTSC /BASELINE 0,ZEROTRANSPOR
      TCOST 1,HALFTRANSPORTCOST 0,DOUBLETRANSPORTCOST 0/;
  21  *PARAMETERS SCENARIOS(SWITCH) HALFTRANSPORTCOSTSC /BASELINE 0,ZEROTRANSPOR
      TCOST 0,HALFTRANSPORTCOST 1,DOUBLETRANSPORTCOST 0/;
  22  PARAMETERS SCENARIOS(SWITCH) DOUBLETRANSPORTCOSTSC /BASELINE 0,ZEROTRANSPO
      RTCOST 0,HALFTRANSPORTCOST 0,DOUBLETRANSPORTCOST 1/;
  23   
  24   
