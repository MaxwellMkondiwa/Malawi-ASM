GAMS 24.1.2  r40979 Released Jun 16, 2013 WEX-VS8 x86/MS Windows 07/25/23 15:17:09 Page 19
: A MALAWI AGR SECTOR PROTOTYPE MODEL FOR POLICY ANALYSIS; 2015-REF
DECLARE AND DEFINE VARIABLES, EQUATIONS AND THE SECTOR MODEL


2383  EQUATIONS
2384  *-------------------------------------------------------------------------
      ------------------------------
2385  * EQUATION..............  DESCRIPTION.....................................
      .............................
2386  *-------------------------------------------------------------------------
      ------------------------------
2387   OBJ                      OBJECTIVE FUNCTION SECTOR WELFARE 1000'S
2388   INPUTREG(JR,JIR)         REGIONAL INPUT CONSTRAINTS
2389   INPUTREGCL(JR,JIT,JIC)   CROP LAND INPUT CONSTRAINTS
2390   PRODREG(JR,JPR)          REGIONAL PRODUCT CONSTRAINTS;
2391  * CONVEX2(JR)              CONVEXITY REQUIREMENT
2392  * HISTAREA2(JR,JIC)        TOTAL LAND CONSTRAINT CROPS RESTRICTED TO HISTO
      RICAL MIXES;
2393  *INPUTNON(JIN)            NONREGIONAL INPUT CONSTRAINTS
2394  * PRODNON(JPN)             NONREGIONAL PRODUCT CONSTRAINTS;
2395  *-------------------------------------------------------------------------
      ------------------------------
2396   
2397   
2398  OBJ..
2399   
2400   ZOBJ =E=
2401   
2402   .001*( SUM(JR, - SUM(JIR $JRIR(JR,JIR), (CSR(JR,JIR,"INTERCEPT")*ZR(JR,JI
      R)
2403                                           + 0.5*CSR(JR,JIR,"SLOPE")*(ZR(JR,
      JIR)**2)))
2404   
2405                  - SUM(JIT $JRT(JR,JIT), SUM(JIC $JRIC(JR,JIC),
2406                                                  (CSC(JR,JIT,JIC,"INTERCEPT
      ")*ZC(JR,JIT,JIC)
2407                                                  + 0.5*CSC(JR,JIT,JIC,"SLOP
      E")*(ZC(JR,JIT,JIC)**2))))
2408   
2409                  + SUM(JPR $JRPR(JR,JPR), (CDR(JR,JPR,"INTERCEPT")*YR(JR,JP
      R)
2410                                       + 0.5*CDR(JR,JPR,"SLOPE")*(YR(JR,JPR)
      **2)))
2411   
2412                  - SUM(JRD, SUM(JIP $JRSDIP(JR,JRD,JIP), CTR(JR,JRD,JIP)*TR
      (JR,JRD,JIP)))));
2413   
                      - SUM(JIP $JIPRM(JR,JIP), CXMR(JR,JIP,"M-PRICE")*TMR(JR,JI
      P))
       
                      + SUM(JIP $JIPRX(JR,JIP), CXMR(JR,JIP,"X-PRICE")*TXR(JR,JI
      P)))
       
              - SUM(JIN, (CSN(JIN,"INTERCEPT")*ZN(JIN) + 0.5*CSN(JIN,"SLOPE")*(Z
      N(JIN)**2)))
       
              + SUM(JPN, (CDN(JPN,"INTERCEPT")*YN(JPN) + 0.5*CDN(JPN,"SLOPE")*(Y
      N(JPN)**2)))
       
              - SUM(JIP $JIPNM(JIP), CXMN(JIP,"M-PRICE")*TMN(JIP))
       
              + SUM(JIP $JIPNX(JIP), CXMN(JIP,"X-PRICE")*TXN(JIP)));
       
2428   
2429  INPUTREG(JR,JIR) $JRIR(JR,JIR)..
2430   
2431  *SUM(JXR $(JRX(JR,JXR) AND (NOT JXC(JXR))), AR(JR,JXR,JIR)*XR(JR,JXR))
2432   
2433   SUM(JXC, SUM(JIT $JRXT(JR,JXC,JIT), ARC(JR,JXC,JIT,JIR)*XRC(JR,JXC,JIT)))
2434   
2435   - ZR(JR,JIR)
2436   
2437   + SUM(JRD $JRSDIP(JR,JRD,JIR), TR(JR,JRD,JIR))
2438   
2439   - SUM(JRS $JRSDIP(JRS,JR,JIR), TR(JRS,JR,JIR))=E= 0;
2440   
2441  * - TMR(JR,JIR) $(JR,JIR) + TXR(JR,JIR) $JIPRX(JR,JIR) =E= 0;
2442   
2443  *HISTAREA2(JR,JIC)..
2444  *   SUM(YR2, LAMBDA2(JR,YEAR)*AREADATA(JR,JIC,YEAR))-CROPLAND2(JR,JIC)=L=0
      ;
2445   
2446  INPUTREGCL(JR,JIT,JIC) $(JRT(JR,JIT) AND JRIC(JR,JIC))..
2447   
2448    SUM(JXC $JRXT(JR,JXC,JIT), ARC(JR,JXC,JIT,JIC)*XRC(JR,JXC,JIT)) - ZC(JR,
      JIT,JIC) =L= 0;
2449   
2450   
2451  PRODREG(JR,JPR) $JRPR(JR,JPR)..
2452   
2453    SUM(JXC, SUM(JIT $JRXT(JR,JXC,JIT), ARC(JR,JXC,JIT,JPR)*XRC(JR,JXC,JIT))
      )
2454   
2455   + YR(JR,JPR)
2456   
2457   + SUM(JRD $JRSDIP(JR,JRD,JPR), TR(JR,JRD,JPR))
2458   
2459   - SUM(JRS $JRSDIP(JRS,JR,JPR), TR(JRS,JR,JPR))=E= 0;
2460   
2461  *- TMR(JR,JPR) $JIPRM(JR,JPR) + TXR(JR,JPR) $JIPRX(JR,JPR) =E= 0;
2462   
2463  *CONVEX2(JR)..
2464  *         SUM(YEAR,LAMBDA2(JR,YEAR))=L=1;
      OTHERREG(JR,JOC) $JROCR(JR,JOC)..
       
       SUM(JXR $(JRX(JR,JXR) AND (NOT JXC(JXR))), AOR(JR,JXR,JOC)*XR(JR,JXR))
       
       + SUM(JXC, SUM(JIT $JRXT(JR,JXC,JIT), AORC(JR,JXC,JIT,JOC)*XRC(JR,JXC,JIT
      )))
       
       =E= BOR(JR,JOC);
       
       
      INPUTNON(JIN)..
       
       SUM(JR, SUM(JXR $(JRX(JR,JXR) AND (NOT JXC(JXR))), AR(JR,JXR,JIN)*XR(JR,J
      XR)))
       
       + SUM(JR, SUM(JXC, SUM(JIT $JRXT(JR,JXC,JIT), ARC(JR,JXC,JIT,JIN)*XRC(JR,
      JXC,JIT))))
       
       + SUM(JX$JXN(JX), AN(JX,JIN)*XN(JX))
       
       - ZN(JIN) - TMN(JIN) $JIPNM(JIN) + TXN(JIN) $JIPNX(JIN) =E= 0;
       
       
      PRODNON(JPN)..
       
       SUM(JR, SUM(JXR $(JRX(JR,JXR) AND (NOT JXC(JXR))), AR(JR,JXR,JPN)*XR(JR,J
      XR)))
       
       + SUM(JR, SUM(JXC, SUM(JIT $JRXT(JR,JXC,JIT), ARC(JR,JXC,JIT,JPN)*XRC(JR,
      JXC,JIT))))
       
       + SUM(JX$JXN(JX), AN(JX,JPN)*XN(JX))
       
       + YN(JPN) - TMN(JPN) $JIPNM(JPN) + TXN(JPN) $JIPNX(JPN) =E= 0;
       
       
      OTHERNON(JOC) $JOCN(JOC)..
       
       SUM(JXN, AON(JXN,JOC)*XN(JXN))=E= BON(JOC);
