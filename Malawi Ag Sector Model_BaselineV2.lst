2712   
2713  PARAMETER  RT71(JR,JIP,JU,JTH2)  REGIONAL INPUT & PRODUCT RESULTS BY REGIO
      N;
2714   RT71(JR,JIP,JU,JTH2) = 0.0;
2715   RT71(JR,JIR,JU,"PROD")$JUIPX(JIR,JU)
2716     = SUM(JXC, SUM(JIT $(JRXT(JR,JXC,JIT) AND (ARC(JR,JXC,JIT,JIR)<0)),
2717           - ARC(JR,JXC,JIT,JIR)*XRC.L(JR,JXC,JIT)));
2718  *     + SUM(JXR$((NOT JXC(JXR)) AND (AR(JR,JXR,JIR)<0)), - AR(JR,JXR,JIR)*
      XR.L(JR,JXR));
2719   RT71(JR,JPR,JU,"PROD")$JUIPX(JPR,JU)
2720     = SUM(JXC, SUM(JIT $(JRXT(JR,JXC,JIT) AND (ARC(JR,JXC,JIT,JPR)<0)),
2721           - ARC(JR,JXC,JIT,JPR)*XRC.L(JR,JXC,JIT)));
2722  *     + SUM(JXR$((NOT JXC(JXR)) AND (AR(JR,JXR,JPR)<0)), - AR(JR,JXR,JPR)*
      XR.L(JR,JXR));
2723   RT71(JR,JIR,JU,"USE")$JUIPX(JIR,JU)
2724     = SUM(JXC, SUM(JIT $(JRXT(JR,JXC,JIT) AND (ARC(JR,JXC,JIT,JIR)>0)),
2725           ARC(JR,JXC,JIT,JIR)*XRC.L(JR,JXC,JIT)));
2726  *     + SUM(JXR$((NOT JXC(JXR)) AND (AR(JR,JXR,JIR)>0)), AR(JR,JXR,JIR)*XR
      .L(JR,JXR));
2727   RT71(JR,JPR,JU,"USE")$JUIPX(JPR,JU)
2728     = SUM(JXC, SUM(JIT $(JRXT(JR,JXC,JIT) AND (ARC(JR,JXC,JIT,JPR)>0)),
2729           ARC(JR,JXC,JIT,JPR)*XRC.L(JR,JXC,JIT)));
2730  *     + SUM(JXR$((NOT JXC(JXR)) AND (AR(JR,JXR,JPR)>0)), AR(JR,JXR,JPR)*XR
      .L(JR,JXR));
2731   RT71(JR,JIP,JU,"SHIP-IN")$JUIPX(JIP,JU) = SUM(JRS$JRSDIP(JRS,JR,JIP), TR.
      L(JRS,JR,JIP));
2732   RT71(JR,JIP,JU,"SHIP-OUT")$JUIPX(JIP,JU) = SUM(JRD$JRSDIP(JR,JRD,JIP), TR
      .L(JR,JRD,JIP));
2733   RT71(JR,JPR,JU,"DEMAND")$(JRPR(JR,JPR) AND JUIPX(JPR,JU)) = YR.L(JR,JPR);
2734   RT71(JR,JIR,JU,"SUPPLY")$(JRIR(JR,JIR) AND JUIPX(JIR,JU)) = ZR.L(JR,JIR);
2735  * RT71(JR,JIP,JU,"EXPORT")$(JIPRX(JR,JIP) AND JUIPX(JIP,JU)) = TXR.L(JR,JI
      P);
2736  * RT71(JR,JIP,JU,"IMPORT")$(JIPRM
2737  *(JR,JIP) AND JUIPX(JIP,JU)) = TMR.L(JR,JIP);
2738   RT71(JR,JPR,JU,"PRICE")$(JRPR(JR,JPR) AND JUIPX(JPR,JU)) = PRODREG.M(JR,J
      PR);
2739   RT71(JR,JIR,JU,"PRICE")$(JRIR(JR,JIR) AND JUIPX(JIR,JU)) = INPUTREG.M(JR,
      JIR);
2740   RT71(JR,JPR,JU,"LAMBDA")$(JRPR(JR,JPR) AND JUIPX(JPR,JU)) = YR.M(JR,JPR);
2741   RT71(JR,JIR,JU,"LAMBDA")$(JRIR(JR,JIR) AND JUIPX(JIR,JU)) = ZR.M(JR,JIR);
2742   OPTION  RT71:3:2:1;     DISPLAY$PRNT("71")  RT71;
2743   
