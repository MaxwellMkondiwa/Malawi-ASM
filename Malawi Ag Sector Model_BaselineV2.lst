2755  PARAMETER  RT81(JIP,JU,JRS,JRD)  INTER-REG INPUT & PRODUCT SHIPMENTS;
2756   RT81(JIP,JU,JRS,JRD) = RT07(JRS,JRD,JIP,JU,"LEVEL");
2757   OPTION  RT81:3:1:1;     DISPLAY$PRNT("81")  RT81;
2758   
2759  SET  JPR91(JPR)  CROP PRODUCTS FOR RESULTS TABLE 91 /MAIZE,RICE,CASSAVA,PO
      TATOES,BEANS,GROUNDNUTS/;
2760   
2761  PARAMETER  RT91(JPR91,JR,JTH2)  CROP PRODUCT RESULTS BY REGION TABLE 91;
2762   RT91(JPR91,JR,"PROD") = SUM(JU$JUIPX(JPR91,JU),RT71(JR,JPR91,JU,"PROD"));
2763   RT91(JPR91,JR,"USE") = SUM(JU$JUIPX(JPR91,JU),RT71(JR,JPR91,JU,"USE"));
2764   RT91(JPR91,JR,"SHIP-IN") = SUM(JU$JUIPX(JPR91,JU),RT71(JR,JPR91,JU,"SHIP-
      IN"));
2765   RT91(JPR91,JR,"DEMAND") = SUM(JU$JUIPX(JPR91,JU),RT71(JR,JPR91,JU,"DEMAND
      "));
2766   RT91(JPR91,JR,"EXPORT") = SUM(JU$JUIPX(JPR91,JU),RT71(JR,JPR91,JU,"EXPORT
      "));
2767   RT91(JPR91,JR,"IMPORT") = SUM(JU$JUIPX(JPR91,JU),RT71(JR,JPR91,JU,"IMPORT
      "));
2768   RT91(JPR91,JR,"PRICE") = SUM(JU$JUIPX(JPR91,JU),RT71(JR,JPR91,JU,"PRICE")
      );
2769   RT91(JPR91,JR,"AREA") = SUM(JU$JUIPX(JPR91,JU),
2770        SUM(JXC, SUM(JIT $(JRXT(JR,JXC,JIT) AND (ARC(JR,JXC,JIT,JPR91)<0)),X
      RC.L(JR,JXC,JIT))));
2771   RT91(JPR91,JR,"YIELD")$(RT91(JPR91,JR,"AREA")>0) = RT91(JPR91,JR,"PROD")/
      RT91(JPR91,JR,"AREA");
2772   OPTION  RT91:3:1:1;     DISPLAY$PRNT("91")  RT91;
2773   
2774  PARAMETER  RT92(JPR91,JTH2)  CROP RESULTS TOTAL TABLE 92;
2775   RT92(JPR91,"AREA") = SUM(JR,RT91(JPR91,JR,"AREA"));
2776   RT92(JPR91,"PROD") = SUM(JR,RT91(JPR91,JR,"PROD"));
2777   RT92(JPR91,"USE") = SUM(JR,RT91(JPR91,JR,"USE"));
2778   RT92(JPR91,"DEMAND") = SUM(JR,RT91(JPR91,JR,"DEMAND"));
2779   RT92(JPR91,"EXPORT") = SUM(JR,RT91(JPR91,JR,"EXPORT"));
2780   RT92(JPR91,"IMPORT") = SUM(JR,RT91(JPR91,JR,"IMPORT"));
2781    RT92(JPR91,"SHIP-IN") = SUM(JR,RT91(JPR91,JR,"SHIP-IN"));
2782   RT92(JPR91,"YIELD")$(RT92(JPR91,"AREA")>0) = RT92(JPR91,"PROD")/RT92(JPR9
      1,"AREA");
2783   
2784   
2785   OPTION  RT92:3:1:1;     DISPLAY$PRNT("92")  RT92;
2786   
