      CT ITEMS;
2752   RT73(JIP,JR,JU,JTH2)$JIP73(JIP) = RT71(JR,JIP,JU,JTH2);
2753   OPTION  RT73:3:2:1;     DISPLAY$PRNT("73")  RT73;
