 362  SET  JBR(JR,JB)  BUDGETS MAPPED TO REGIONS;
 363       JBR(JR,JB) = YES;
 364   
 365  SET  JBC(JB)  CROP BUDGETS USED TO CONSTRUCT CROP PRODUCTION ACTIVITIES  /
      B-MAIZE, B-RICE, B-CASSAVA,
 366       B-POTATOES, B-BEANS, B-GROUNDNUTS, B-MIX-00*B-MIX-09/;
 367   
 368  * Maxwell, 2nd July
 369  *SET  YR2(JBC) CROP AREA BY YEAR /B-MIX-00*B-MIX-09/
 370   
 371  SET YEAR HISTORICAL MIXES YEARS /2000*2009 /;
 372   
 373   
 374  SET  JBL(JB)  LIVESTOCK BUDGETS USED TO CONSTRUCT LIVESTOCK PRODUCTION ACT
      IVITIES;
 375   
 376  SET  JBCT(JBC,JIT)  CROP BUDGETS MAPPED TO CROP LAND TYPES;
 377  *    MAP ALL CROP BUDGETS TO CROP LAND TYPES THEN EXCLUDE EXCEPTIONS
 378       JBCT(JBC,JIT)=YES;
 379   
 380  SET  JBCR(JR,JXC,JBC)  CROP BUDGETS MAPPED TO CROP PROD ACTIVITIES AND REG
      IONS;
 381       JBCR(JR,JXC,JBC) = NO;
 382   
 383       JBCR(JR,JXC,JBC)
 384       $(JRX(JR,JXC) AND JBR(JR,JBC) AND
 385        (SUM(JIT$(JRT(JR,JIT) AND JRX(JR,JXC) AND JBCT(JBC,JIT)),1)>0)) = YE
      S;
 386   
