      = 1;
2054   
2055  OPTION  CNV1:6:1:1;     DISPLAY  CNV1;
2056  OPTION  CNV2:6:0:1;     DISPLAY  CNV2;
2057   
2058  ICK01(JBC) = NO;      ICK01(JBC)$(SUM(JU$JUB(JBC,JU),1)<1) = YES;     DISP
      LAY ICK01;
2059  ICK02(JBC) = NO;      ICK02(JBC)$(SUM(JU$JUB(JBC,JU),1)>1) = YES;     DISP
      LAY ICK02;
2060  ICK03(JXC) = NO;      ICK03(JXC)$(SUM(JU$JUX(JXC,JU),1)<1) = YES;     DISP
      LAY ICK03;
2061  ICK04(JXC) = NO;      ICK04(JXC)$(SUM(JU$JUX(JXC,JU),1)>1) = YES;     DISP
      LAY ICK04;
