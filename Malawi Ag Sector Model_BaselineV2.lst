      CTIVITIES,
  27      03  CROP PRODUCTION ACTIVITIES,              04  REGIONAL INPUT SUPPLY
       ACTIVITIES,
  28      05  CROP LAND INPUT SUPPLY ACTIVITIES,       06  REGIONAL PRODUCT DEMA
      ND ACTIVITIES,
  29      07  INTER-REG TRANSPORTATION ACTIVITIES,     08  REGIONAL IMPORT ACTIV
      ITIES,
  30      09  REGIONAL EXPORT ACTIVITIES,
  31      31  REGIONAL INPUT CONSTRAINTS,              32  CROP LAND INPUT CONST
      RAINTS,
  32      33  REGIONAL PRODUCT CONSTRAINTS,
  33      41  CROP ACTIVITIES BY REG & LAND TYPE,      42  CROP ACTIVITIES SUMME
      D BY REGION,
  34      43  TOTAL CROP PROD ACTIVITY LEVELS,
  35      71  REG INPUT & PROD RESULTS BY REGION,      72  REG INPUT & PROD RESU
      LTS BY ITEM,
  36      73  REG INPUT & PROD RESULTS SELECT ITEMS,
  37      81  INTER-REG INPUT & PRODUCT SHIPMENTS,
  38      91  CROP RESULTS BY REG TABLE 91,            92  CROP RESULTS TOTAL TA
      BLE 92 /;
  39   
  40  * PRINT TABLE IF PRNT = 1
  41  PARAMETER  PRNT(KRT)
  42     /01*03 1, 04*09 1, 31*33 1, 41 1, 42 1, 43 1, 71 1, 72 1, 73 1, 81 1, 9
      1 1, 92 1/;
  43   
