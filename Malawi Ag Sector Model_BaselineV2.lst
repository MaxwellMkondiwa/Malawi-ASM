SET DECLARATIONS AND ASSIGNMENTS


 203  SET  JP(JIP)  PRODUCTS  /MAIZE, RICE, CASSAVA, POTATOES, BEANS, GROUNDNUTS
      , BLANK-P/;
 204   
 205  SET  JPR(JP)  REGIONAL PRODUCTS  /MAIZE, RICE, CASSAVA, POTATOES, BEANS, G
      ROUNDNUTS/;
 206   
 207  SET  JPN(JP)  NONREGIONAL PRODUCTS  /BLANK-P/;
 208   
 209  SET  JRPR(JR,JP)  REGIONAL PRODUCTS MAPPED TO REGIONS;
 210   
 211  *    MAP ALL REGIONAL PRODUCTS TO ALL REGIONS, THEN IDENTIFY EXCEPTIONS
 212   
 213       JRPR(JR,JPR) = YES;
 214   
 215       JRPR("TO","RICE") = NO;
 216       JRPR("NTCH","RICE") = NO;
 217   
 218  *    CANCEL MAPPINGS OF NONREGIONAL PRODUCTS TO REGIONS
 219   
 220       JRPR(JR,JP)$(NOT JPR(JP)) = NO;
 221   
 222  SET  JRSD(JRS,JRD)  INTER-REGIONAL TRANSPORT ROUTES - DESTINATIONS MAPPED 
      TO SOURCES;
 223   
 224  *    ALLOW TRANSPORT BETWEEN ALL REGIONS BUT PRECLUDE ROUTES W THE SAME SO
      URCE AND DESTINATION
 225   
 226       JRSD(JRS,JRD) = YES;   JRSD(JRS,JRS) = NO;
 227   
 228  SET  JTIP(JIP)  TRANSPORTED REGIONAL INPUTS AND PRODUCTS  /MAIZESEED, RICE
      SEED, CASSAVASEED, POTATOSEED,
 229                  BEANSSEED, GNUTSSEED, FERT1, FERT2, PESTICIDES, MAIZE, RIC
      E, CASSAVA, POTATOES, BEANS,
 230                  GROUNDNUTS/;
 231   
 232  SET  JRSDIP(JRS,JRD,JIP)  INPUTS AND PRODUCTS MAPPED TO SOURCES AND DESTIN
      ATIONS;
 233       JRSDIP(JRS,JRD,JIP) = YES;
 234   
 235   
 236  *    THE FOLLOWING REGIONAL PRODUCTS MAY BE SHIPPED BETWEEN ANY TWO REGION
      S IN WHICH THEY OCCUR
 237   
 238  *     JRSDIP(JRS,JRD,"MAIZE") = YES;            JRSDIP(JRS,JRD,"BEANS") = 
      YES;
 239  *     JRSDIP(JRS,JRD,"RICE") = YES;             JRSDIP(JRS,JRD,"GROUNDNUTS
      ") = YES;
 240  *     JRSDIP(JRS,JRD,"CASSAVA") = YES;
 241  *     JRSDIP(JRS,JRD,"POTATOES") = YES;
 242   
 243  *    INPUTS AND PRODUCTS THAT ARE NOT TRANSPORTED ARE BELOW EXCLUDED FROM 
      MAPPINGS TO ROUTES.  ALSO
 244  *    EXCLUDED ARE SHIPMENTS WHERE THE ROUTE IS NOT AN IDENTIFIED SHIPPING 
      ROUTE, OR IF THE SOURCE OR
 245  *    DESTINATION HAS NOT MARKET FOR THE ITEM
 246   
 247       JRSDIP(JRS,JRD,JIP)$(NOT JTIP(JIP)) = NO;
 248       JRSDIP(JRS,JRD,JTIP)$(NOT JRSD(JRS,JRD)) = NO;
 249       JRSDIP(JRS,JRD,JIR)$((NOT JRIR(JRS,JIR)) OR (NOT JRIR(JRD,JIR))) = NO
      ;
 250       JRSDIP(JRS,JRD,JPR)$((NOT JRPR(JRS,JPR)) OR (NOT JRPR(JRD,JPR))) = NO
      ;
 251   
 252   
